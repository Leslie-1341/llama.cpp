#!/usr/bin/env bash
# OS Agent gate entrypoint.
# Compatible modes: implement | review | review-fix | audit

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/artifact.sh"
source "$SCRIPT_DIR/lib/diff-analyzer.sh"
source "$SCRIPT_DIR/lib/target-mapper.sh"
source "$SCRIPT_DIR/lib/fingerprint.sh"
source "$SCRIPT_DIR/lib/cache.sh"

GATE_MODE=""
GATE_BUILD_DIR="${GATE_BUILD_DIR:-build}"
GATE_PROFILE=""
GATE_FORCE_FRESH=0
GATE_ALLOW_REUSE=-1
GATE_COMPONENT_REUSE=1

usage() {
    cat <<'HELP'
Usage: gate-runner <implement|review|review-fix|audit> [options]

Default profiles:
  implement    quick   changed syntax, mapped targets, selected build/tests
  review       verify  reuse unchanged PASS evidence; otherwise quick + clang-tidy
  review-fix   quick   validate only the current changed surface
  audit        audit   read-only plan/mapping; no build or parser execution

Options:
  --build-dir DIR      CMake build directory (default: build)
  --profile PROFILE    audit | quick | verify | full
  --full               force full relevant regression and isolated Harness full test
  --fresh              disable evidence reuse
  --reuse              allow compatible PASS reuse
  --no-reuse           disable reuse
  -q, --quiet          only emit the final result marker
  -v, --verbose        stream full command logs
  -h, --help           show help

Exit codes: 0 PASS, 1 FAIL, 2 UNRESOLVED, 3 INCOMPLETE,
            4 NO_CHANGES, 5 UNVERIFIED
HELP
}

while (($#)); do
    case "$1" in
        implement|review|review-fix|audit) [[ -z "$GATE_MODE" ]] || { printf 'mode specified twice\n' >&2; exit 3; }; GATE_MODE="$1" ;;
        --build-dir) shift; (($#)) || { printf '--build-dir requires a value\n' >&2; exit 3; }; GATE_BUILD_DIR="$1" ;;
        --build-dir=*) GATE_BUILD_DIR="${1#*=}" ;;
        --profile) shift; (($#)) || { printf '--profile requires a value\n' >&2; exit 3; }; GATE_PROFILE="$1" ;;
        --profile=*) GATE_PROFILE="${1#*=}" ;;
        --full) GATE_PROFILE=full ;;
        --fresh|--no-reuse) GATE_FORCE_FRESH=1; GATE_ALLOW_REUSE=0 ;;
        --reuse) GATE_ALLOW_REUSE=1 ;;
        -q|--quiet) GATE_LOG_LEVEL=0 ;;
        -v|--verbose) GATE_LOG_LEVEL=2 ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown argument: %s\n' "$1" >&2; exit 3 ;;
    esac
    shift
done

[[ -n "$GATE_MODE" ]] || { usage >&2; exit 3; }
if [[ -z "$GATE_PROFILE" ]]; then
    case "$GATE_MODE" in
        implement|review-fix) GATE_PROFILE=quick ;;
        review) GATE_PROFILE=verify ;;
        audit) GATE_PROFILE=audit ;;
    esac
fi
case "$GATE_PROFILE" in audit|quick|verify|full) ;; *) printf 'invalid profile: %s\n' "$GATE_PROFILE" >&2; exit 3 ;; esac
if (( GATE_ALLOW_REUSE < 0 )); then [[ "$GATE_MODE" == review ]] && GATE_ALLOW_REUSE=1 || GATE_ALLOW_REUSE=0; fi
if (( GATE_FORCE_FRESH )) || [[ "$GATE_PROFILE" == full ]]; then GATE_COMPONENT_REUSE=0; fi

GATE_HARNESS_VERSION="$(cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo unknown)"
artifact_init
cd "$REPO_ROOT"
diff_analyze
diff_report > "$GATE_ARTIFACT_DIR/diff-report.txt"
gate_log 1 "mode=$GATE_MODE profile=$GATE_PROFILE diff=$DIFF_TOTAL"

if (( DIFF_TOTAL == 0 )); then
    GATE_FINGERPRINT="$(fingerprint_compute)"
    gate_emit_summary "$EXIT_NO_CHANGES"
    exit "$EXIT_NO_CHANGES"
fi

GATE_FINGERPRINT="$(fingerprint_compute)"
printf '%s\n' "$GATE_FINGERPRINT" > "$GATE_ARTIFACT_DIR/fingerprint.txt"

if (( GATE_ALLOW_REUSE && ! GATE_FORCE_FRESH )) && [[ "$GATE_PROFILE" == verify ]]; then
    GATE_REUSED_FROM="$(cache_find_pass "$GATE_FINGERPRINT" 2>/dev/null || true)"
fi

source "$SCRIPT_DIR/checks/run-checks.sh"
source "$SCRIPT_DIR/gates/define-gates.sh"
run_gate_profile

set +e
gate_final_verdict
final_code=$?
set -e
if (( final_code == EXIT_PASS )) && [[ "$GATE_PROFILE" != audit ]]; then
    cache_save_pass "$GATE_FINGERPRINT"
fi
gate_emit_summary "$final_code"
exit "$final_code"
